generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  id          String     @id @default(cuid())
  name        String     @unique
  displayName String
  description String?
  color       String?
  priority    Int        @default(0)
  isSystem    Boolean    @default(false)
  isDefault   Boolean    @default(false)
  permissions Json       @default("[]")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  userRoles   UserRole[]
  users       User[]

  @@index([name])
  @@index([isDefault])
  @@map("roles")
}

model User {
  id                           String                @id @default(cuid())
  kindeId                      String?               @unique
  email                        String                @unique
  name                         String?
  firstName                    String?
  lastName                     String?
  primaryRoleId                String?
  status                       UserStatus            @default(PENDING_VERIFICATION)
  phoneNumber                  String?
  preferredLocale              String                @default("en")
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt
  lastLoginAt                  DateTime?
  auditLogs                    AuditLog[]
  uploadedDocuments            EventDocument[]
  eventFeedback                EventFeedback[]
  createdEvents                Event[]               @relation("EventCreator")
  managedEvents                Event[]               @relation("EventManager")
  notificationLogs             NotificationLog[]
  payments                     Payment[]
  pendingPayments              PendingPayment[]
  profile                      Profile?
  performedRegistrationActions RegistrationHistory[] @relation("RegistrationHistoryPerformedBy")
  registrationHistory          RegistrationHistory[] @relation("RegistrationHistoryUser")
  eventRegistrations           Registration[]
  assignedUserRoles            UserRole[]            @relation("UserRoleAssigner")
  userRoles                    UserRole[]
  primaryRole                  Role?                 @relation(fields: [primaryRoleId], references: [id])
  createdVideoClips            VideoClip[]           @relation("VideoClipCreator")
  videoReactions               VideoReaction[]
  waitingListEntries           WaitingList[]

  @@index([email])
  @@index([primaryRoleId, status])
  @@index([kindeId])
  @@index([status, lastLoginAt])
  @@index([preferredLocale])
  @@map("users")
}

model UserRole {
  id             String    @id @default(cuid())
  userId         String
  roleId         String
  assignedAt     DateTime  @default(now())
  assignedBy     String?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  assignedByUser User?     @relation("UserRoleAssigner", fields: [assignedBy], references: [id])
  role           Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Profile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  bio                   String?
  avatar                String?
  company               String?
  jobTitle              String?
  website               String?
  linkedin              String?
  twitter               String?
  emailNotifications    Boolean  @default(true)
  smsNotifications      Boolean  @default(false)
  marketingEmails       Boolean  @default(false)
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Event {
  id                    String                @id @default(cuid())
  title                 String
  slug                  String                @unique
  description           String?
  shortDescription      String?
  type                  EventType             @default(MEETUP)
  status                EventStatus           @default(DRAFT)
  capacity              Int
  price                 Decimal?              @db.Decimal(10, 2)
  currency              String                @default("EUR")
  startDate             DateTime
  endDate               DateTime?
  timezone              String                @default("Europe/Bratislava")
  venue                 String?
  address               String?
  city                  String?
  country               String?               @default("Slovakia")
  isOnline              Boolean               @default(false)
  onlineUrl             String?
  registrationStartDate DateTime?
  registrationEndDate   DateTime?
  requiresApproval      Boolean               @default(false)
  allowWaitingList      Boolean               @default(true)
  maxWaitingList        Int?
  requiresPayment       Boolean               @default(false)
  bankAccountId         String?
  translations          Json?
  tags                  String[]
  imageUrl              String?
  websiteUrl            String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  creatorId             String
  managerId             String?
  categoryId            String?
  documents             EventDocument[]
  feedback              EventFeedback[]
  bankAccount           BankAccount?          @relation(fields: [bankAccountId], references: [id])
  category              EventCategory?        @relation(fields: [categoryId], references: [id])
  creator               User                  @relation("EventCreator", fields: [creatorId], references: [id])
  manager               User?                 @relation("EventManager", fields: [managerId], references: [id])
  payments              Payment[]
  pendingPayments       PendingPayment[]
  registrationHistory   RegistrationHistory[]
  registrations         Registration[]
  videoClips            VideoClip[]
  waitingList           WaitingList[]

  @@index([status, startDate])
  @@index([creatorId])
  @@index([slug])
  @@index([startDate])
  @@index([type, status, startDate])
  @@index([city, country, startDate])
  @@index([registrationStartDate, registrationEndDate])
  @@index([requiresPayment, price])
  @@index([categoryId, status])
  @@index([tags])
  @@map("events")
}

model EventCategory {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  description  String?
  color        String?
  icon         String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  translations Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  events       Event[]

  @@index([isActive, sortOrder])
  @@index([slug])
  @@map("event_categories")
}

model EventFeedback {
  id                 String    @id @default(cuid())
  eventId            String
  userId             String
  rating             Int
  title              String?
  comment            String?
  organizationRating Int?
  contentRating      Int?
  venueRating        Int?
  isApproved         Boolean   @default(false)
  isPublic           Boolean   @default(true)
  moderatedBy        String?
  moderatedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  event              Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, isApproved, isPublic])
  @@index([rating, createdAt])
  @@map("event_feedback")
}

model EventDocument {
  id                   String   @id @default(cuid())
  eventId              String
  title                String
  description          String?
  fileName             String
  filePath             String
  fileSize             Int
  mimeType             String
  type                 String   @default("general")
  isPublic             Boolean  @default(false)
  requiresRegistration Boolean  @default(true)
  uploadedBy           String
  uploadedAt           DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  event                Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploader             User     @relation(fields: [uploadedBy], references: [id])

  @@index([eventId, type, isPublic])
  @@index([type, requiresRegistration])
  @@map("event_documents")
}

model Registration {
  id                      String                    @id @default(cuid())
  userId                  String?
  eventId                 String
  status                  RegistrationStatus        @default(PENDING)
  registrationType        RegistrationType          @default(INDIVIDUAL)
  registrationSource      RegistrationSource        @default(WEB_FORM)
  isGroupLeader           Boolean                   @default(true)
  groupLeaderId           String?
  groupSize               Int                       @default(1)
  friendPosition          Int?
  guestEmail              String?
  guestName               String?
  guestPhone              String?
  isGuestRequest          Boolean                   @default(false)
  friendsData             Json?                     @default("[]")
  registeredAt            DateTime                  @default(now())
  confirmedAt             DateTime?
  cancelledAt             DateTime?
  notes                   String?
  dietaryRequirements     String?
  specialRequests         String?
  requiresPayment         Boolean                   @default(false)
  paymentId               String?                   @unique
  pendingPaymentId        String?
  paymentStatus           RegistrationPaymentStatus @default(PENDING_VERIFICATION)
  paymentClaimedAt        DateTime?
  paymentVerifiedAt       DateTime?
  paymentRejectedAt       DateTime?
  paymentRejectionReason  String?
  paymentMethod           PaymentMethod?
  friendInfo              Json?
  registeredBy            String?
  promotedFromWaitingList Boolean                   @default(false)
  waitingListPosition     Int?
  promotedAt              DateTime?
  event                   Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  groupLeader             Registration?             @relation("GroupMembers", fields: [groupLeaderId], references: [id], onDelete: Cascade)
  groupMembers            Registration[]            @relation("GroupMembers")
  payment                 Payment?                  @relation(fields: [paymentId], references: [id])
  pendingPayment          PendingPayment?           @relation("RegistrationPendingPayment", fields: [pendingPaymentId], references: [id])
  user                    User?                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@unique([eventId, guestEmail, guestName])
  @@index([eventId, status])
  @@index([userId, status])
  @@index([status, registeredAt])
  @@index([requiresPayment, paymentId])
  @@index([confirmedAt])
  @@map("registrations")
}

model WaitingList {
  id                  String           @id @default(cuid())
  userId              String?
  eventId             String
  position            Int
  joinedAt            DateTime         @default(now())
  notifiedAt          DateTime?
  registrationType    RegistrationType @default(INDIVIDUAL)
  isGroupEntry        Boolean          @default(false)
  groupSize           Int              @default(1)
  guestEmail          String?
  guestName           String?
  guestPhone          String?
  isGuestRequest      Boolean          @default(false)
  friendsData         Json?            @default("[]")
  notes               String?
  dietaryRequirements String?
  specialRequests     String?
  promotedAt          DateTime?
  pendingPaymentId    String?
  event               Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pendingPayment      PendingPayment?  @relation("WaitingListPendingPayment", fields: [pendingPaymentId], references: [id])
  user                User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@unique([eventId, guestEmail, guestName])
  @@index([eventId, position])
  @@index([userId, joinedAt])
  @@index([isGroupEntry, groupSize])
  @@index([registrationType, position])
  @@index([isGuestRequest, guestEmail])
  @@index([promotedAt, pendingPaymentId])
  @@index([notifiedAt, position])
  @@map("waiting_list")
}

model Payment {
  id                String          @id @default(cuid())
  userId            String
  eventId           String?
  registrationId    String?         @unique
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("EUR")
  method            PaymentMethod   @default(QR_CODE)
  status            PaymentStatus   @default(PENDING)
  bankAccountId     String?
  variableSymbol    String?         @unique
  constantSymbol    String?
  specificSymbol    String?
  qrCodeData        String?
  qrCodeUrl         String?
  paidAt            DateTime?
  verifiedAt        DateTime?
  refundedAt        DateTime?
  claimedAt         DateTime?
  verifiedBy        String?
  verificationNotes String?
  description       String?
  notes             String?
  reference         String?
  pendingPaymentId  String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  bankAccount       BankAccount?    @relation(fields: [bankAccountId], references: [id])
  event             Event?          @relation(fields: [eventId], references: [id])
  pendingPayment    PendingPayment? @relation("PaymentPendingPayment", fields: [pendingPaymentId], references: [id])
  user              User            @relation(fields: [userId], references: [id])
  registration      Registration?

  @@index([userId])
  @@index([eventId])
  @@index([status, createdAt])
  @@index([variableSymbol])
  @@index([method, status])
  @@index([paidAt, verifiedAt])
  @@index([currency, amount])
  @@index([bankAccountId, status])
  @@map("payments")
}

model PendingPayment {
  id             String               @id @default(cuid())
  userId         String
  eventId        String
  amount         Decimal              @db.Decimal(10, 2)
  currency       String               @default("EUR")
  type           PendingPaymentType
  status         PendingPaymentStatus @default(PENDING)
  paymentMethod  PaymentMethod        @default(BANK_TRANSFER)
  bankAccountId  String?
  variableSymbol String?              @unique
  constantSymbol String?
  specificSymbol String?
  qrCodeData     String?
  qrCodeUrl      String?
  createdAt      DateTime             @default(now())
  expiresAt      DateTime             @default(dbgenerated("(now() + '7 days'::interval)"))
  processedAt    DateTime?
  cancelledAt    DateTime?
  description    String?
  notes          String?
  metadata       Json?
  payments       Payment[]            @relation("PaymentPendingPayment")
  bankAccount    BankAccount?         @relation(fields: [bankAccountId], references: [id])
  event          Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  registrations  Registration[]       @relation("RegistrationPendingPayment")
  waitingList    WaitingList[]        @relation("WaitingListPendingPayment")

  @@unique([userId, eventId, type])
  @@index([userId, status])
  @@index([eventId, status])
  @@index([status, expiresAt])
  @@index([type, status])
  @@index([expiresAt])
  @@index([variableSymbol])
  @@index([paymentMethod, status])
  @@map("pending_payments")
}

model BankAccount {
  id              String           @id @default(cuid())
  name            String
  iban            String           @unique
  bankName        String?
  accountNumber   String?
  bankCode        String?
  swift           String?
  isDefault       Boolean          @default(false)
  isActive        Boolean          @default(true)
  qrCodeEnabled   Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  events          Event[]
  payments        Payment[]
  pendingPayments PendingPayment[]

  @@index([isDefault, isActive])
  @@index([isActive, qrCodeEnabled])
  @@index([iban])
  @@map("bank_accounts")
}

model RegistrationHistory {
  id             String             @id @default(cuid())
  userId         String
  eventId        String
  action         RegistrationAction
  previousStatus String?
  newStatus      String?
  reason         String?
  adminNotes     String?
  performedById  String?
  timestamp      DateTime           @default(now())
  ipAddress      String?
  userAgent      String?
  event          Event              @relation(fields: [eventId], references: [id])
  performedBy    User?              @relation("RegistrationHistoryPerformedBy", fields: [performedById], references: [id])
  user           User               @relation("RegistrationHistoryUser", fields: [userId], references: [id])

  @@index([userId, eventId])
  @@index([timestamp])
  @@map("registration_history")
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  action      AuditAction
  resource    String
  resourceId  String?
  oldData     Json?
  newData     Json?
  changes     Json?
  description String?
  ipAddress   String?
  userAgent   String?
  sessionId   String?
  timestamp   DateTime    @default(now())
  user        User?       @relation(fields: [userId], references: [id])

  @@index([userId, timestamp])
  @@index([resource, resourceId])
  @@index([timestamp])
  @@index([action, resource, timestamp])
  @@index([resource, action, timestamp])
  @@index([sessionId, timestamp])
  @@map("audit_logs")
}

model SystemConfig {
  key         String   @id
  value       String
  description String?
  type        String   @default("string")
  category    String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("system_config")
}

model NotificationTemplate {
  id            String            @id @default(cuid())
  name          String            @unique
  type          NotificationType
  subject       String?
  content       Json
  variables     Json?
  isActive      Boolean           @default(true)
  isSystem      Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  notifications NotificationLog[]

  @@map("notification_templates")
}

model NotificationLog {
  id           String                @id @default(cuid())
  templateId   String?
  userId       String?
  type         NotificationType
  status       NotificationStatus    @default(PENDING)
  recipient    String
  subject      String?
  content      String
  sentAt       DateTime?
  deliveredAt  DateTime?
  failedAt     DateTime?
  errorMessage String?
  eventId      String?
  metadata     Json?
  createdAt    DateTime              @default(now())
  template     NotificationTemplate? @relation(fields: [templateId], references: [id])
  user         User?                 @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([type, recipient])
  @@map("notification_logs")
}

model VideoCategory {
  id           String      @id @default(cuid())
  name         String      @unique
  slug         String      @unique
  description  String?
  color        String?
  icon         String?
  isActive     Boolean     @default(true)
  sortOrder    Int         @default(0)
  translations Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  videoClips   VideoClip[]

  @@index([isActive, sortOrder])
  @@index([slug])
  @@map("video_categories")
}

model VideoClip {
  id              String          @id @default(cuid())
  title           String
  description     String?
  slug            String          @unique
  youtubeVideoId  String          @unique
  youtubeUrl      String
  thumbnailUrl    String?
  duration        Int?
  embedCode       String?
  status          VideoClipStatus @default(DRAFT)
  privacy         VideoPrivacy    @default(PUBLIC)
  tags            String[]
  language        String          @default("en")
  moderatedBy     String?
  moderatedAt     DateTime?
  moderationNotes String?
  likeCount       Int             @default(0)
  eventId         String?
  categoryId      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  publishedAt     DateTime?
  creatorId       String
  category        VideoCategory?  @relation(fields: [categoryId], references: [id])
  creator         User            @relation("VideoClipCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  event           Event?          @relation(fields: [eventId], references: [id])
  reactions       VideoReaction[]

  @@index([status, privacy, publishedAt])
  @@index([creatorId, status])
  @@index([eventId, status])
  @@index([categoryId, status])
  @@index([tags])
  @@index([youtubeVideoId])
  @@index([likeCount, publishedAt])
  @@index([createdAt, status])
  @@index([language, status])
  @@map("video_clips")
}

model VideoReaction {
  id        String       @id @default(cuid())
  type      ReactionType
  videoId   String
  userId    String
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     VideoClip    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([videoId, type])
  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("video_reactions")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
  POSTPONED
}

enum EventType {
  WORKSHOP
  SEMINAR
  CONFERENCE
  MEETUP
  TRAINING
  SOCIAL
  OTHER
}

enum RegistrationType {
  INDIVIDUAL
  GROUP
  GUEST
  CORPORATE
  STUDENT
  VIP
}

enum RegistrationSource {
  WEB_FORM
  ADMIN_PANEL
  API
  IMPORT
  WAITING_LIST_PROMOTION
  PHONE
  EMAIL
  WALK_IN
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REJECTED
  ATTENDED
  NO_SHOW
}

enum RegistrationPaymentStatus {
  PENDING_VERIFICATION
  PAYMENT_SENT_AWAITING_VERIFICATION
  PAYMENT_VERIFIED
  VERIFIED_CASH
  REJECTED
  WAITING_LIST_PROMOTED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  QR_CODE
  CASH
  CARD
  OTHER
}

enum PendingPaymentStatus {
  PENDING
  EXPIRED
  CANCELLED
  PROCESSED
}

enum PendingPaymentType {
  REGISTRATION
  WAITING_LIST_PROMOTION
  ADMIN_CREATED
  SYSTEM_GENERATED
}

enum RegistrationAction {
  REGISTERED
  CONFIRMED
  CANCELLED
  PROMOTED_FROM_WAITING_LIST
  MOVED_TO_WAITING_LIST
  PAYMENT_COMPLETED
  PAYMENT_FAILED
  ADMIN_APPROVED
  ADMIN_REJECTED
  PENDING_PAYMENT_CREATED
  PENDING_PAYMENT_EXPIRED
  PENDING_PAYMENT_CANCELLED
  PENDING_PAYMENT_PROCESSED
  GROUP_REGISTRATION_CREATED
  FRIEND_ADDED_TO_GROUP
  FRIEND_REMOVED_FROM_GROUP
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

enum VideoClipStatus {
  DRAFT
  PUBLISHED
  MODERATED
  REJECTED
  ARCHIVED
}

enum VideoPrivacy {
  PUBLIC
  PRIVATE
  EVENT_ONLY
  ROLE_RESTRICTED
}

enum ReactionType {
  LIKE
  LOVE
  LAUGH
  WOW
  ANGRY
  SAD
  FIRE
  CLAP
  HEART_EYES
  THUMBS_UP
  THUMBS_DOWN
}
